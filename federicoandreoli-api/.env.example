APP_NAME="Federico Andreoli API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.curaxe.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Frontend SPA (CORS + Sanctum stateful). Comma-separated for più origini (es. staging).
FRONTEND_URL=http://localhost:5173
# Produzione: FRONTEND_URL=https://curaxe.it
# FRONTEND_URLS=https://curaxe.it,https://www.curaxe.it,http://localhost:5173

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,curaxe.it,www.curaxe.it

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=federicoandreoli
# DB_USERNAME=
# DB_PASSWORD=
# DB_CONNECTION=pgsql (vedi docs/DATABASE-CHOICE.md per PostGIS)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Coda e cache senza Redis (obbligatorio per questo progetto)
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis non utilizzato — non impostare REDIS_* in produzione.

# --- Email: Resend (consigliato) oppure SMTP Hostinger ---
# Guida: docs/RESEND-SETUP.md
MAIL_MAILER=log
# Produzione Resend:
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxx
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@curaxe.it"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Stripe — preferire wizard landlord in admin; .env come fallback
# Guida sicurezza: docs/SECURITY-INTEGRATIONS.md
STRIPE_MODE=test
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# WebAuthn / Passkey (landlord platform_admin)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Curaxe"
WEBAUTHN_ORIGIN=http://localhost:5173
# Produzione:
# WEBAUTHN_RP_ID=curaxe.it
# WEBAUTHN_ORIGIN=https://curaxe.it
# WEBAUTHN_ORIGINS=https://curaxe.it,https://www.curaxe.it

# Cloudflare (edge + bot). Guida: docs/CLOUDFLARE-SETUP.md
CLOUDFLARE_TRUST_PROXIES=false
CLOUDFLARE_PROXIES=*
CLOUDFLARE_TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
